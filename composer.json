{
    "name": "rossaddison/yii-gii",
    "type": "library",
    "description": "Yii Framework Code Generator Extension",
    "keywords": [
        "yii",
        "gii",
        "code generator",
        "dev"
    ],
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yiisoft/yii-gii/issues?state=open",
        "source": "https://github.com/yiisoft/yii-gii",
        "forum": "https://www.yiiframework.com/forum/",
        "wiki": "https://www.yiiframework.com/wiki/",
        "irc": "ircs://irc.libera.chat:6697/yii",
        "chat": "https://t.me/yii3en"
    },
    "funding": [
        {
            "type": "opencollective",
            "url": "https://opencollective.com/yiisoft"
        },
        {
            "type": "github",
            "url": "https://github.com/sponsors/yiisoft"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "8.4 - 8.5",
        "httpsoft/http-basis": ">=1.1.2",
        "phpspec/php-diff": ">=1.1.3",
        "psr/http-message": ">=2",
        "symfony/console": ">=8.0.9",
        "yiisoft/active-record": ">=1.0.2",
        "yiisoft/aliases": ">=3.1.1",
        "yiisoft/arrays": ">=3.2.1",
        "yiisoft/csrf": ">=2.2.3",
        "yiisoft/data-response": ">=2.2",
        "yiisoft/db": ">=2.0.1",
        "yiisoft/friendly-exception": ">=1.2",
        "yiisoft/http": ">=1.3",
        "yiisoft/hydrator": ">=1.6.3",
        "yiisoft/injector": ">=1.2.1",
        "yiisoft/input-http": ">=1.0.1",
        "yiisoft/json": ">=1.1",
        "yiisoft/router": ">=4.0.2",
        "yiisoft/strings": ">=2.7",
        "yiisoft/validator": ">=2.5.1",
        "yiisoft/yii-console": ">=2.4.2",
        "yiisoft/yii-middleware": ">=1.1.2" 
    },
    "require-dev": {
        "maglnet/composer-require-checker": ">=4.24",
        "jetbrains/phpstorm-attributes": ">=1.2",
        "nyholm/psr7": ">=1.8.2",
        "phpunit/phpunit": ">=13.1.8",
        "rector/rector": ">=2.4.2",
        "roave/infection-static-analysis-plugin": "*",
        "spatie/phpunit-watcher": ">=1.24.4",
        "vimeo/psalm": ">=6.16.1",
        "yiisoft/cache": ">=3.2",
        "yiisoft/db-sqlite": ">=2",
        "yiisoft/di": ">=1.4.1",
        "yiisoft/dummy-provider": ">=1.1",
        "yiisoft/event-dispatcher": ">=1.1",
        "yiisoft/files": ">=2.1",
        "yiisoft/log": ">=2.2.1",
        "yiisoft/translator": ">=3.2.1"
    },
    "autoload": {
        "psr-4": {
            "Yiisoft\\Yii\\Gii\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yiisoft\\Yii\\Gii\\Tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        },
        "config-plugin-options": {
            "source-directory": "config"
        },
        "config-plugin": {
            "params": "params.php",
            "di": "di.php",
            "routes": "routes.php"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "config": {
        "sort-packages": true,
        "bump-after-update": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "composer/package-versions-deprecated": true,
            "php-http/discovery": false
        }
    },
    "scripts": {
        "test": "phpunit --testdox --no-interaction",
        "test-watch": "phpunit-watcher watch"
    }
}
